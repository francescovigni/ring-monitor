# Ring API - Get this by running: npm run auth
RING_REFRESH_TOKEN=your_ring_refresh_token_here

# Google Sheets - Service Account credentials
# Path to service account JSON file (relative to project root)
GOOGLE_SERVICE_ACCOUNT_PATH=./src/service_account.json

# Google Spreadsheet ID (from the URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit)
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Sheet name within the spreadsheet (optional, defaults to "Ring Events")
GOOGLE_SHEET_NAME=Ring Events

# Batch interval in milliseconds for writing to Google Sheets (optional, defaults to 5000)
BATCH_INTERVAL_MS=5000
