#!/bin/bash
set -e

# Configuration - UPDATE THESE VALUES
SERVER="user@your-server-ip"
REMOTE_DIR="/path/to/ring-monitor"

echo "🚀 Deploying Ring Monitor to $SERVER:$REMOTE_DIR"

# Build locally first
echo "📦 Building TypeScript..."
npm run build

# Create remote directory
echo "📁 Creating remote directory..."
ssh $SERVER "mkdir -p $REMOTE_DIR/src"

# Copy files to server
echo "📤 Copying files to server..."
scp -r dist/ $SERVER:$REMOTE_DIR/
scp src/service_account.json $SERVER:$REMOTE_DIR/src/
scp package.json package-lock.json $SERVER:$REMOTE_DIR/
scp Dockerfile docker-compose.yml $SERVER:$REMOTE_DIR/
scp .env $SERVER:$REMOTE_DIR/

# Build and start on server
echo "🐳 Building and starting Docker container..."
ssh $SERVER "cd $REMOTE_DIR && docker-compose down 2>/dev/null || true && docker-compose up -d --build"

# Show status
echo "📊 Container status:"
ssh $SERVER "cd $REMOTE_DIR && docker-compose ps"

echo ""
echo "✅ Deployment complete!"
echo "📝 View logs: ssh $SERVER 'cd $REMOTE_DIR && docker-compose logs -f'"
